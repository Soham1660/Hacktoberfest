# Ollama server that hosts the open-weight model (default shown)
OLLAMA_HOST=http://127.0.0.1:11434
# Model that judges each change. Must support structured outputs. Default: qwen3:8b (Apache-2.0)
PR_CHECKER_MODEL=qwen3:8b
# Model that extracts claims from the PR description (defaults to PR_CHECKER_MODEL)
# PR_CHECKER_CLAIMS_MODEL=qwen3:8b
# Port the app listens on (serves the UI and the API)
PORT=8787
# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour when importing PRs by URL
# GITHUB_TOKEN=
